{
  "hosting": {
    "site": "justkviz-v2",
    "public": "apps/web/dist",
    "ignore": ["firebase.offline-hosting.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      },
      {
        "source": "/{,index.html,admin,admin/**,events,events/*/**,referee,referee/**,projector,projector/**,account,invite/**,offline.html,offline.webmanifest,offline-sw.js}",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }]
      },
      {
        "source": "/{admin,admin/**,projector,projector/**,referee,referee/**,account,invite,invite/**,events/*/registration/**,offline.html}",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
      }
    ],
    "rewrites": [
      { "regex": "^/events/[A-Za-z0-9_-]+$", "function": { "functionId": "servePublicEventMeta", "region": "europe-west1" } },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
